# --- Qwen/DashScope AI API（截图识别用） ---
QWEN_API_KEY=sk-your-key-here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# --- 服务器部署 ---
DEPLOY_HOST=47.113.189.191
DEPLOY_USER=root
DEPLOY_PASSWORD=your-password-here

# --- PostgreSQL 数据库（Step 6 启用） ---
DB_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant2026
POSTGRES_DB=stockdb

